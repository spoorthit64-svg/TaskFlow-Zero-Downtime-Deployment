# TaskFlow Backend Environment Variables Configuration

# Server Port (Render assigns dynamic PORT automatically, local fallback: 8080)
PORT=8080

# MongoDB Atlas Connection String
# Replace with your MongoDB Atlas cluster connection URI
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/taskflow?retryWrites=true&w=majority

# JWT Authentication Secret (256-bit secret key)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970

# JWT Expiration in milliseconds (86400000 ms = 24 hours)
JWT_EXPIRATION_MS=86400000

# CORS Allowed Origins (comma-separated, local development + Vercel frontend)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://taskflow.vercel.app